<UserControl x:Class="ABAH.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ABAH.Desktop.Converters"
             xmlns:vm="clr-namespace:ABAH.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:IncomeToBrushConverter x:Key="IncomeBrush" />
        <conv:PercentToStarConverter x:Key="PercentStar" />
    </UserControl.Resources>

    <Grid Margin="28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Row 1: Stat cards ============ -->
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Stats}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,18,0">
                        <StackPanel>
                            <Grid>
                                <Border Width="42" Height="42" CornerRadius="12"
                                        HorizontalAlignment="Left" Background="{Binding AccentBackground}">
                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                        CornerRadius="999" Padding="8,3" Background="{Binding AccentBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DeltaGlyph}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Delta}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding AccentBrush}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============ Row 2: Chart + Materials ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Chart -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                <StackPanel>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Sampah Terkumpul" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Berat (kg) per bulan, 2026" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding MonthlyWaste}" Height="210" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Bottom">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Width="30" Height="{Binding BarHeight}"
                                            VerticalAlignment="Bottom" CornerRadius="8,8,4,4">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF2EA373" Offset="0" />
                                                <GradientStop Color="#FF1A6B4C" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ToolTipService.ToolTip>
                                            <TextBlock Text="{Binding Value, StringFormat='{}{0} kg'}" />
                                        </ToolTipService.ToolTip>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Month}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Materials -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Kategori Material" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Distribusi bulan ini" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Materials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,15">
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Left" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding ValueText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding PercentText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <Border Height="8" CornerRadius="999" Background="{StaticResource BgBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentStar}}" />
                                                <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentStar}, ConverterParameter=rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="999" Background="{Binding BarBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Row 3: Pickups + Transactions ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Recent pickups -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Pickup Terbaru" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Status penjemputan" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <Button Content="Lihat semua" HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}" />
                    </Grid>

                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="MATERIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="KOLEKTOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="BERAT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,4" />

                    <ItemsControl ItemsSource="{Binding RecentPickups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Material}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Estimate}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Collector}" FontSize="13.5"
                                                   VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Weight}" FontSize="13.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                                        <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                CornerRadius="999" Padding="10,4"
                                                Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent transactions -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Transaksi Terbaru" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Riwayat pembayaran" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentTransactions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Counterparty}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Amount}" FontSize="13.5" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{Binding IsIncome, Converter={StaticResource IncomeBrush}}" />
                                            <TextBlock Text="{Binding Date}" FontSize="11.5" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
